{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python3",
          "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py"], "timeout": 20 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Read|Bash", "hooks": [ { "type": "command", "command": "python3",
          "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard.py"], "timeout": 10 } ] }
    ]
  }
}
